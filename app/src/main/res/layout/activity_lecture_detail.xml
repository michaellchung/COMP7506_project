<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/notemind_surface"
    android:orientation="vertical">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="14dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_back"
            app:tint="@color/notemind_text_primary" />

        <TextView
            android:id="@+id/toolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/notemind_text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="Lecture 5" />

        <ImageButton
            android:id="@+id/btnDeleteLecture"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/delete_lecture"
            android:src="@drawable/ic_delete"
            app:tint="@color/notemind_text_secondary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/notemind_hairline" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Lecture header card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/notemind_card"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/notemind_hairline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/lectureCourseName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.06"
                        android:textAllCaps="true"
                        android:textColor="@color/notemind_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="COMP7506 Mobile Computing" />

                    <TextView
                        android:id="@+id/lectureTitleLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:letterSpacing="-0.02"
                        android:textColor="@color/notemind_text_primary"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="Lecture 5" />

                    <LinearLayout
                        android:id="@+id/lectureDateRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_calendar"
                            app:tint="@color/notemind_text_secondary" />

                        <TextView
                            android:id="@+id/lectureDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:textColor="@color/notemind_text_secondary"
                            android:textSize="13sp"
                            tools:text="2026-04-30" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Capture (Action) card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/actionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/notemind_card"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/notemind_hairline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="@string/lecture_actions"
                        android:textAllCaps="true"
                        android:textColor="@color/notemind_text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- Recording row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStartRecording"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="@string/start_recording"
                            android:textAllCaps="false"
                            android:textSize="14sp"
                            app:backgroundTint="@color/notemind_primary"
                            app:cornerRadius="14dp"
                            app:icon="@drawable/ic_mic"
                            app:iconGravity="textStart"
                            app:iconSize="18dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStopRecording"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginStart="10dp"
                            android:text="@string/stop_recording"
                            android:textAllCaps="false"
                            android:textSize="14sp"
                            android:visibility="gone"
                            app:cornerRadius="14dp"
                            app:strokeColor="@color/notemind_primary"
                            app:strokeWidth="1dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnUploadAudio"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="@string/upload_audio"
                            android:textAllCaps="false"
                            android:textSize="14sp"
                            app:cornerRadius="14dp"
                            app:icon="@drawable/ic_upload"
                            app:iconGravity="textStart"
                            app:iconSize="18dp"
                            app:strokeColor="@color/notemind_primary"
                            app:strokeWidth="1dp" />
                    </LinearLayout>

                    <!-- OCR row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTakePhoto"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="@string/take_photo"
                            android:textAllCaps="false"
                            android:textSize="14sp"
                            app:cornerRadius="14dp"
                            app:icon="@drawable/ic_camera"
                            app:iconGravity="textStart"
                            app:iconSize="18dp"
                            app:strokeColor="@color/notemind_primary"
                            app:strokeWidth="1dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPickImage"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="@string/pick_image"
                            android:textAllCaps="false"
                            android:textSize="14sp"
                            app:cornerRadius="14dp"
                            app:icon="@drawable/ic_gallery"
                            app:iconGravity="textStart"
                            app:iconSize="18dp"
                            app:strokeColor="@color/notemind_primary"
                            app:strokeWidth="1dp" />
                    </LinearLayout>

                    <!-- Upload file row -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUploadFile"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:text="@string/upload_file"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_upload"
                        app:iconGravity="textStart"
                        app:iconSize="18dp"
                        app:strokeColor="@color/notemind_primary"
                        app:strokeWidth="1dp" />

                    <!-- Progress -->
                    <LinearLayout
                        android:id="@+id/progressSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <ProgressBar
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:indeterminateTint="@color/notemind_primary" />

                        <TextView
                            android:id="@+id/actionStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:textColor="@color/notemind_text_secondary"
                            android:textSize="14sp"
                            tools:text="Processing…" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Notes section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:letterSpacing="-0.01"
                android:text="@string/lecture_notes"
                android:textColor="@color/notemind_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/notesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="2"
                tools:listitem="@layout/item_note" />

            <TextView
                android:id="@+id/emptyNotesHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:padding="16dp"
                android:text="@string/no_lecture_notes"
                android:textColor="@color/notemind_text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
