<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/notemind_surface"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/notemind_surface"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="18dp"
            android:paddingEnd="24dp"
            android:paddingBottom="100dp">

            <!-- ── Header: App title + avatar button ────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/appTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="-0.02"
                    android:text="@string/app_name"
                    android:textColor="@color/notemind_text_primary"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/avatarButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="U"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ── Hero headline ─────────────────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:letterSpacing="-0.04"
                android:lineSpacingExtra="-2dp"
                android:text="Study smarter.\nFrom your own notes."
                android:textColor="@color/notemind_text_primary"
                android:textSize="42sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="5dp"
                android:text="@string/home_intro"
                android:textColor="@color/notemind_text_secondary"
                android:textSize="16sp" />

            <!-- ── Module chip row ────────────────────────────────────── -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRecording"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:minWidth="150dp"
                        android:text="@string/recording_module"
                        android:textAllCaps="false"
                        android:textColor="@color/notemind_text_primary"
                        app:backgroundTint="@color/notemind_card"
                        app:cornerRadius="24dp"
                        app:strokeColor="@color/notemind_hairline"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOcr"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="10dp"
                        android:minWidth="150dp"
                        android:text="@string/ocr_module"
                        android:textAllCaps="false"
                        android:textColor="@color/notemind_text_primary"
                        app:backgroundTint="@color/notemind_card"
                        app:cornerRadius="24dp"
                        app:strokeColor="@color/notemind_hairline"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnKnowledgeBase"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="10dp"
                        android:minWidth="170dp"
                        android:text="@string/kb_module"
                        android:textAllCaps="false"
                        android:textColor="@color/notemind_text_primary"
                        app:backgroundTint="@color/notemind_card"
                        app:cornerRadius="24dp"
                        app:strokeColor="@color/notemind_hairline"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLibrary"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="10dp"
                        android:minWidth="140dp"
                        android:text="@string/library_module"
                        android:textAllCaps="false"
                        android:textColor="@color/notemind_text_primary"
                        app:backgroundTint="@color/notemind_card"
                        app:cornerRadius="24dp"
                        app:strokeColor="@color/notemind_hairline"
                        app:strokeWidth="1dp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- ── Selected module card ───────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                app:cardBackgroundColor="@color/notemind_card"
                app:cardCornerRadius="30dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/notemind_hairline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="@string/selected_module"
                        android:textAllCaps="true"
                        android:textColor="@color/notemind_text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/selectedModuleTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:letterSpacing="-0.02"
                        android:textColor="@color/notemind_text_primary"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        tools:text="Recording Summary" />

                    <TextView
                        android:id="@+id/selectedModuleDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="5dp"
                        android:textColor="@color/notemind_text_secondary"
                        android:textSize="15sp"
                        tools:text="Upload English lecture audio and get transcript, outline, terms, and exam hotspots." />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="22dp"
                        android:background="@color/notemind_hairline" />

                    <TextView
                        android:id="@+id/selectedModuleTasks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:lineSpacingExtra="6dp"
                        android:textColor="@color/notemind_text_primary"
                        android:textSize="14sp"
                        tools:text="Next steps" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Demo result card ───────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/notemind_card"
                app:cardCornerRadius="30dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/notemind_hairline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/mockResultTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:letterSpacing="-0.01"
                        android:text="@string/demo_result"
                        android:textColor="@color/notemind_text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/mockResultBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="6dp"
                        android:textColor="@color/notemind_text_secondary"
                        android:textSize="15sp"
                        tools:text="A structured summary preview appears here." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- ── Floating Chat Button ──────────────────────────────────────── -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabChat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="28dp"
        android:contentDescription="Open AI Chat"
        app:backgroundTint="@color/notemind_text_primary"
        app:elevation="4dp"
        app:fabSize="normal"
        app:srcCompat="@drawable/ic_chat"
        app:tint="@color/white" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
